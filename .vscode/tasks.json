{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build STM32 Project",
      "type": "shell",
      "command": "make",
      "args": [
        "-C",
        "${workspaceFolder}/Debug",
        "all"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Clean STM32 Project",
      "type": "shell",
      "command": "make",
      "args": [
        "-C",
        "${workspaceFolder}/Debug",
        "clean"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
