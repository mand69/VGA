
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build STM32 Project",
      "type": "shell",
      "command": "make",
      "args": ["-C", "${workspaceFolder}/Debug", "all"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "Clean STM32 Project",
      "type": "shell",
      "command": "make",
      "args": ["-C", "${workspaceFolder}/Debug", "clean"],
      "problemMatcher": []
    },
    {
      "label": "test-debugger",
      "type": "shell",
      "command": "echo DEBUGGER_TEST_GESLAAGD",
      "problemMatcher": []
    }
  ]
}
